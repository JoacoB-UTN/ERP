{
  "name": "@erp/server-agent",
  "version": "0.1.0",
  "private": true,
  "description": "ERP Server maintenance agent — scheduled PostgreSQL backups, integrity verification, retention and restore. Runs as its own Windows service, independent of apps/api.",
  "main": "dist/main.js",
  "bin": {
    "erp-backup": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@erp/shared": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@erp/eslint-config": "*",
    "@erp/typescript-config": "*",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "globals": "^17.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
