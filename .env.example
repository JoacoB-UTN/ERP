# ---- apps/api ----
NODE_ENV=development
API_PORT=3001

# Local Postgres (docker compose maps host 5433 -> container 5432 to avoid
# clashing with a locally installed Postgres on 5432)
DATABASE_URL="postgresql://erp:erp@localhost:5433/erp_platform_dev?schema=public"

# Local Redis (docker compose maps host 6380 -> container 6379)
REDIS_URL="redis://localhost:6380"

# Comma-separated list of allowed browser origins (Gestión, Facturación).
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"
LOG_LEVEL="info"

# ---- Authentication ----
# Signs short-lived access token JWTs. MUST be set to a real random secret
# in production — the app refuses to boot with the dev default when
# NODE_ENV=production. Generate one with e.g. `openssl rand -base64 48`.
AUTH_ACCESS_TOKEN_SECRET="dev-insecure-access-secret-change-me"
AUTH_ACCESS_TOKEN_TTL="15m"
AUTH_REFRESH_TOKEN_TTL="30d"
# Leave unset in local dev (cookies become host-only for "localhost", which
# browsers share across ports — see packages/config/src/env.ts). Set to a
# real domain (e.g. ".example.com") in production.
AUTH_COOKIE_DOMAIN=
# Cookies require HTTPS when true. Keep "false" for local HTTP dev; set to
# "true" in any real deployment (served over HTTPS).
AUTH_COOKIE_SECURE="false"
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10

# ---- Dev seed ----
# Used only by `npm run db:seed`, never read by the running API. Leaving
# SEED_ADMIN_PASSWORD unset uses a clearly-fake local-only default; a real
# value is REQUIRED when NODE_ENV=production (the seed script refuses to
# create a known credential in production).
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD=

# ---- apps/gestion / apps/facturacion ----
# NOT required for normal local dev — Gestión/Facturación resolve the
# API's URL (and the sibling workspace's URL) at RUNTIME from whatever
# host the page was itself loaded from (localhost, 127.0.0.1, a LAN IP —
# see docs/desktop-lan-architecture.md's "Runtime LAN addressing"). Leave
# these unset to get that automatic behavior. Set one only as an explicit
# dev/test override (e.g. pointing at an API running on a non-standard
# port) — it then wins outright over runtime derivation.
# NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# NEXT_PUBLIC_GESTION_URL="http://localhost:3000"
# NEXT_PUBLIC_FACTURACION_URL="http://localhost:3002"
