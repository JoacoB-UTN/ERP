{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "removeComments": true,
    // Deliberately false: Nest CLI's `deleteOutDir` (nest-cli.json) wipes
    // `dist/` on every build/start, but incremental tsc trusts its
    // `.tsbuildinfo` cache and, seeing no source changes, silently emits
    // nothing into the now-empty directory — a zero-emit "successful"
    // build with no dist/main.js. Full recompiles are slower but never
    // silently wrong.
    "incremental": false
  }
}
